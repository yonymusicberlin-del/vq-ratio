<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VQ STOCKS">
<meta name="theme-color" content="#FFD000">
<title>VQ Stocks — TRUSSウォッチリスト</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Noto+Sans+JP:wght@300;400;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#060A0E;--surface:#0C1118;--border:#182028;
  --green:#00FF88;--yellow:#FFD000;--red:#FF3A3A;--blue:#00AAFF;
  --purple:#A855F7;--orange:#FF4500;--dim:#2A3A4A;--text:#B8CCE0;--text2:#5A7A9A;
  --mono:'Share Tech Mono',monospace;--sans:'Noto Sans JP',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
body{background:var(--bg);color:var(--text);font-family:var(--sans);overflow-x:hidden;padding-bottom:30px;}
body::after{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,208,0,0.003) 3px,rgba(255,208,0,0.003) 4px);pointer-events:none;z-index:9999;}

/* HEADER */
.hdr{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid var(--border);background:var(--surface);position:sticky;top:0;z-index:50;}
.hdr-left{display:flex;align-items:center;gap:9px;}
.hdr-dot{width:7px;height:7px;border-radius:50%;background:var(--yellow);box-shadow:0 0 8px var(--yellow);animation:blink 2s infinite;flex-shrink:0;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.3;}}
.hdr-title{font-family:var(--mono);font-size:13px;letter-spacing:.22em;color:var(--yellow);}
.hdr-sub{font-size:8px;color:var(--dim);letter-spacing:.1em;margin-top:1px;}
.hdr-right{display:flex;gap:7px;align-items:center;}
.data-badge{font-family:var(--mono);font-size:8px;color:var(--yellow);border:1px solid rgba(255,208,0,.3);padding:2px 6px;border-radius:4px;}
.hdr-btn{background:none;border:1px solid var(--border);color:var(--dim);width:30px;height:30px;border-radius:7px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:border-color .2s;}
.hdr-btn:hover{border-color:var(--text2);}
.hdr-btn.spin{animation:spin .5s linear;}
@keyframes spin{to{transform:rotate(360deg);}}

/* STOCK TICKER ROW */
.stocks-row{display:flex;gap:5px;padding:7px 12px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--border);background:var(--surface);}
.stocks-row::-webkit-scrollbar{display:none;}
.stock-btn{flex-shrink:0;padding:5px 13px;border-radius:6px;border:1px solid var(--border);font-family:var(--mono);font-size:11px;cursor:pointer;color:var(--dim);background:var(--bg);transition:all .2s;display:flex;align-items:center;gap:5px;}
.stock-btn:hover{border-color:var(--text2);color:var(--text);}
.stock-btn.on-go{border-color:var(--green);color:var(--green);background:rgba(0,255,136,.06);}
.stock-btn.on-watch{border-color:var(--yellow);color:var(--yellow);background:rgba(255,208,0,.06);}
.stock-btn.on-wait{border-color:var(--orange);color:var(--orange);background:rgba(255,69,0,.06);}
.stock-btn.on-caution{border-color:var(--red);color:var(--red);background:rgba(255,58,58,.06);}
.sdot-go{width:5px;height:5px;border-radius:50%;background:var(--green);flex-shrink:0;}
.sdot-watch{width:5px;height:5px;border-radius:50%;background:var(--yellow);flex-shrink:0;}
.sdot-wait{width:5px;height:5px;border-radius:50%;background:var(--orange);flex-shrink:0;}
.sdot-caution{width:5px;height:5px;border-radius:50%;background:var(--red);flex-shrink:0;}

/* IV ROW */
.ivrow{display:flex;gap:5px;padding:7px 12px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--border);}
.ivrow::-webkit-scrollbar{display:none;}
.ivbtn{flex-shrink:0;padding:4px 11px;border-radius:6px;border:1px solid var(--border);font-family:var(--mono);font-size:10px;cursor:pointer;color:var(--dim);background:var(--bg);}
.ivbtn.on{border-color:var(--yellow);color:var(--yellow);background:rgba(255,208,0,.06);}

/* TRUSS SUMMARY BAR */
.truss-bar{display:flex;align-items:center;gap:10px;padding:6px 14px;background:rgba(0,0,0,.4);border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none;}
.truss-bar::-webkit-scrollbar{display:none;}
.tb-label{font-family:var(--mono);font-size:8px;color:var(--dim);letter-spacing:.1em;flex-shrink:0;}
.tb-item{font-family:var(--mono);font-size:9px;flex-shrink:0;}
.tb-divider{width:1px;height:14px;background:var(--border);flex-shrink:0;}

/* SIGNAL BOX */
.sig-box{margin:10px;border-radius:14px;padding:14px;border:2px solid var(--border);background:var(--surface);transition:all .4s;}
.sig-box.full{border-color:var(--green);background:rgba(0,255,136,.04);}
.sig-box.prep{border-color:var(--orange);background:rgba(255,140,0,.04);}
.sig-box.dry{border-color:var(--purple);background:rgba(168,85,247,.04);}
.sig-box.warn{border-color:var(--yellow);background:rgba(255,208,0,.03);}
.sig-box.caution{border-color:var(--red);background:rgba(255,58,58,.03);}
.sig-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;}
.sig-left{display:flex;flex-direction:column;gap:2px;}
.sig-icon{font-size:24px;line-height:1;}
.sig-title{font-family:var(--mono);font-size:13px;font-weight:bold;margin-top:2px;}
.sig-sub{font-size:8px;color:var(--text2);margin-top:3px;letter-spacing:.08em;}
.sig-right{text-align:right;}
.sig-sym{font-family:var(--mono);font-size:10px;color:var(--text2);letter-spacing:.15em;}
.sig-price{font-family:var(--mono);font-size:22px;color:var(--blue);}
.sig-change{font-family:var(--mono);font-size:10px;margin-top:2px;}
.sig-bp{font-family:var(--mono);font-size:9px;color:var(--text2);margin-top:3px;}

/* CONDITIONS */
.conditions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px;}
.cond{background:rgba(0,0,0,.25);border-radius:9px;padding:9px 7px;text-align:center;border:1px solid var(--border);transition:border-color .3s;}
.cond.ok{border-color:currentColor;}
.cond-icon{font-size:16px;margin-bottom:3px;}
.cond-label{font-size:7px;color:var(--text2);letter-spacing:.07em;margin-bottom:3px;}
.cond-val{font-family:var(--mono);font-size:14px;font-weight:bold;}
.cond-status{font-family:var(--mono);font-size:7px;margin-top:2px;}

/* TRUSS PANEL */
.truss-panel{margin:8px 10px 0;background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.truss-panel-hdr{padding:8px 12px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.truss-panel-title{font-family:var(--mono);font-size:9px;color:var(--text2);letter-spacing:.12em;}
.truss-signal-badge{font-family:var(--mono);font-size:9px;padding:2px 8px;border-radius:4px;font-weight:bold;}
.tsb-go{background:rgba(0,255,136,.15);color:var(--green);border:1px solid rgba(0,255,136,.3);}
.tsb-watch{background:rgba(255,208,0,.12);color:var(--yellow);border:1px solid rgba(255,208,0,.3);}
.tsb-wait{background:rgba(255,69,0,.12);color:var(--orange);border:1px solid rgba(255,69,0,.3);}
.tsb-caution{background:rgba(255,58,58,.1);color:var(--red);border:1px solid rgba(255,58,58,.2);}
.truss-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);}
.tg-cell{background:var(--surface);padding:10px 12px;}
.tg-label{font-family:var(--mono);font-size:8px;color:var(--dim);letter-spacing:.08em;margin-bottom:4px;}
.tg-val{font-family:var(--mono);font-size:16px;font-weight:bold;}
.tg-note{font-family:var(--mono);font-size:7px;color:var(--text2);margin-top:3px;}
.dist-bar-wrap{height:3px;background:var(--dim);border-radius:2px;margin-top:5px;}
.dist-bar-fill{height:3px;border-radius:2px;transition:width .5s;}
.rvol-bar-wrap{height:3px;background:var(--dim);border-radius:2px;margin-top:5px;}
.rvol-bar-fill{height:3px;border-radius:2px;background:var(--yellow);transition:width .4s;}

/* CHARTS */
.chart-wrap{margin:8px 10px 0;background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;position:relative;}
.chart-hdr{padding:8px 12px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:4px;}
.chart-title{font-family:var(--mono);font-size:9px;letter-spacing:.12em;color:var(--text2);}
.legend{display:flex;flex-wrap:wrap;gap:8px;}
.leg{display:flex;align-items:center;gap:4px;font-family:var(--mono);font-size:8px;color:var(--dim);}
.leg-line{width:14px;height:2px;border-radius:1px;}
.leg-dot{width:8px;height:8px;border-radius:50%;}
canvas{width:100%;display:block;}
.sbar{display:flex;align-items:center;gap:7px;padding:6px 12px;font-size:8px;color:var(--dim);font-family:var(--mono);border-top:1px solid var(--border);}
.sdot-s{width:5px;height:5px;border-radius:50%;background:var(--dim);flex-shrink:0;}
.sdot-s.live{background:var(--yellow);box-shadow:0 0 5px var(--yellow);animation:blink 2s infinite;}
.sdot-s.err{background:var(--red);}
.overlay{position:absolute;inset:0;background:rgba(6,10,14,.9);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:20;border-radius:14px;}
.overlay.hide{display:none;}
.ring{width:30px;height:30px;border:2px solid var(--border);border-top-color:var(--yellow);border-radius:50%;animation:spin .7s linear infinite;}
.ov-txt{font-family:var(--mono);font-size:10px;color:var(--dim);}

/* LOG */
.log-wrap{margin:8px 10px 0;background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.log-hdr{padding:8px 12px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.log-hdr-title{font-family:var(--mono);font-size:9px;color:var(--text2);letter-spacing:.12em;}
.log-clear{font-family:var(--mono);font-size:8px;color:var(--dim);cursor:pointer;border:1px solid var(--border);padding:2px 8px;border-radius:4px;background:none;}
.log-body{max-height:160px;overflow-y:auto;}
.log-row{display:grid;grid-template-columns:55px 1fr auto;gap:6px;padding:5px 12px;border-bottom:1px solid rgba(24,32,40,.5);align-items:center;}
.log-time{font-family:var(--mono);font-size:9px;color:var(--dim);}
.log-msg{font-family:var(--mono);font-size:9px;}
.log-detail{font-family:var(--mono);font-size:8px;color:var(--dim);text-align:right;}
.log-empty{padding:14px;text-align:center;font-family:var(--mono);font-size:9px;color:var(--dim);}

/* CAUTION BANNER */
.caution-banner{margin:8px 10px 0;border-radius:10px;padding:10px 12px;border:1px solid rgba(255,58,58,.4);background:rgba(255,58,58,.05);}
.caution-title{font-family:var(--mono);font-size:9px;color:var(--red);letter-spacing:.1em;margin-bottom:4px;}
.caution-text{font-family:var(--mono);font-size:8px;color:rgba(255,150,150,.65);line-height:1.6;}

/* ERROR BOX */
.err-box{margin:8px 10px 0;border-radius:10px;padding:12px;border:1px solid rgba(255,208,0,.2);background:rgba(255,208,0,.03);display:none;}
.err-box.show{display:block;}
.err-title{font-family:var(--mono);font-size:9px;color:var(--yellow);letter-spacing:.1em;margin-bottom:6px;}
.err-text{font-family:var(--mono);font-size:8px;color:var(--dim);line-height:1.7;}
.err-src{font-family:var(--mono);font-size:9px;color:var(--text2);margin-top:6px;}
</style>
</head>
<body>

<!-- HEADER -->
<div class="hdr">
  <div class="hdr-left">
    <div class="hdr-dot"></div>
    <div>
      <div class="hdr-title">VQ STOCKS</div>
      <div class="hdr-sub">VQ比シグナル × TRUSSスクリーニング — REDFORDメソッド</div>
    </div>
  </div>
  <div class="hdr-right">
    <button id="notifBtn" class="hdr-btn" style="width:auto;padding:0 8px;font-size:10px;font-family:var(--mono);" onclick="requestNotif()">🔔</button>
    <span class="data-badge" id="dataBadge">●STOOQ</span>
    <button class="hdr-btn" id="rfBtn" onclick="doRefresh()">↻</button>
  </div>
</div>

<!-- STOCK TICKER ROW -->
<div class="stocks-row" id="stocksRow">
  <div class="stock-btn" data-sym="TRGP" data-bp="253.87" data-truss="go"   data-dot="go"      onclick="selectStock(this)"><div class="sdot-go"></div>TRGP</div>
  <div class="stock-btn" data-sym="AVGO" data-bp="414.61" data-truss="go"   data-dot="go"      onclick="selectStock(this)"><div class="sdot-go"></div>AVGO</div>
  <div class="stock-btn" data-sym="MOD"  data-bp="285.00" data-truss="wait" data-dot="wait"    onclick="selectStock(this)"><div class="sdot-wait"></div>MOD</div>
  <div class="stock-btn" data-sym="MTZ"  data-bp="390.00" data-truss="watch" data-dot="watch"  onclick="selectStock(this)"><div class="sdot-watch"></div>MTZ</div>
  <div class="stock-btn" data-sym="STRL" data-bp="477.03" data-truss="go"   data-dot="go"      onclick="selectStock(this)"><div class="sdot-go"></div>STRL</div>
  <div class="stock-btn" data-sym="AXTI" data-bp="64.25"  data-truss="caution" data-dot="caution" onclick="selectStock(this)"><div class="sdot-caution"></div>AXTI</div>
</div>

<!-- IV ROW -->
<div class="ivrow">
  <button class="ivbtn" data-iv="5m"  onclick="setIv(this)">5分</button>
  <button class="ivbtn" data-iv="15m" onclick="setIv(this)">15分</button>
  <button class="ivbtn" data-iv="1h"  onclick="setIv(this)">1時間</button>
  <button class="ivbtn on" data-iv="1d"  onclick="setIv(this)">日足</button>
  <button class="ivbtn" data-iv="1w"  onclick="setIv(this)">週足</button>
</div>

<!-- TRUSS SUMMARY BAR -->
<div class="truss-bar">
  <div class="tb-label">TRUSS</div>
  <div class="tb-item" style="color:var(--green)">GO: TRGP · AVGO · STRL</div>
  <div class="tb-divider"></div>
  <div class="tb-item" style="color:var(--yellow)">WATCH: MTZ</div>
  <div class="tb-divider"></div>
  <div class="tb-item" style="color:var(--orange)">WAIT: MOD</div>
  <div class="tb-divider"></div>
  <div class="tb-item" style="color:var(--red)">CAUTION: AXTI</div>
</div>

<!-- CAUTION BANNER (shown only for AXTI) -->
<div class="caution-banner" id="cautionBanner" style="display:none;">
  <div class="caution-title">⚠ SPECULATIVE — TRUSS基準外</div>
  <div class="caution-text">TTM EPS -$0.49 損失段階 ／ 過去12ヶ月+900% ／ ATH $96.32更新直後 ／ 高Debt。モメンタム追跡専用。IBD買いポイント基準は適用外。次回決算: 7/30。</div>
</div>

<!-- ERROR BOX -->
<div class="err-box" id="errBox">
  <div class="err-title">⚠ データソース切替中</div>
  <div class="err-text" id="errText"></div>
  <div class="err-src" id="errSrc"></div>
</div>

<!-- SIGNAL BOX -->
<div class="sig-box" id="sigBox">
  <div class="sig-top">
    <div class="sig-left">
      <div class="sig-icon" id="sigIcon">⏳</div>
      <div class="sig-title" id="sigTitle" style="color:var(--dim)">読み込み中...</div>
      <div class="sig-sub" id="sigSub">データ取得中</div>
    </div>
    <div class="sig-right">
      <div class="sig-sym" id="sigSym">—</div>
      <div class="sig-price" id="sigPrice">$——</div>
      <div class="sig-change" id="sigChange" style="color:var(--dim)">——</div>
      <div class="sig-bp" id="sigBP">BP: —</div>
    </div>
  </div>
  <div class="conditions">
    <div class="cond" id="cond1" style="color:var(--yellow)">
      <div class="cond-icon">🟡</div>
      <div class="cond-label">VQ-3 買い圧力</div>
      <div class="cond-val" id="c1val">—</div>
      <div class="cond-status" id="c1status">確認中</div>
    </div>
    <div class="cond" id="cond2" style="color:var(--purple)">
      <div class="cond-icon">🟣</div>
      <div class="cond-label">売り枯れ率</div>
      <div class="cond-val" id="c2val">—</div>
      <div class="cond-status" id="c2status">確認中</div>
    </div>
    <div class="cond" id="cond3" style="color:var(--orange)">
      <div class="cond-icon">⚡</div>
      <div class="cond-label">VQ-5 本シグナル</div>
      <div class="cond-val" id="c3val">—</div>
      <div class="cond-status" id="c3status">確認中</div>
    </div>
  </div>
</div>

<!-- TRUSS PANEL -->
<div class="truss-panel" id="trussPanel">
  <div class="truss-panel-hdr">
    <div class="truss-panel-title">📊 TRUSS チェックポイント — <span id="trussSym">—</span></div>
    <div class="truss-signal-badge tsb-wait" id="trussBadge">WAIT</div>
  </div>
  <div class="truss-grid">
    <div class="tg-cell">
      <div class="tg-label">BUY POINT</div>
      <div class="tg-val" id="tgBP" style="color:var(--blue)">—</div>
      <div class="tg-note" id="tgBPnote">—</div>
    </div>
    <div class="tg-cell">
      <div class="tg-label">DIST FROM BP</div>
      <div class="tg-val" id="tgDist" style="color:var(--green)">—</div>
      <div class="dist-bar-wrap"><div class="dist-bar-fill" id="tgDistBar" style="width:0%"></div></div>
      <div class="tg-note" id="tgDistNote">—</div>
    </div>
    <div class="tg-cell">
      <div class="tg-label">RVOL (現在/20本平均)</div>
      <div class="tg-val" id="tgRvol" style="color:var(--yellow)">—</div>
      <div class="rvol-bar-wrap"><div class="rvol-bar-fill" id="tgRvolBar" style="width:0%"></div></div>
      <div class="tg-note" id="tgRvolNote">計算中...</div>
    </div>
    <div class="tg-cell">
      <div class="tg-label">VDU 検出 (出来高縮小)</div>
      <div class="tg-val" id="tgVDU" style="color:var(--dim)">—</div>
      <div class="tg-note" id="tgVDUnote">ベース形成の確認</div>
    </div>
  </div>
</div>

<!-- MAIN CHART -->
<div class="chart-wrap" id="mainWrap">
  <div class="overlay" id="ov">
    <div class="ring"></div>
    <div class="ov-txt" id="ovTxt">データ取得中...</div>
  </div>
  <div class="chart-hdr">
    <div class="chart-title" id="mainChartTitle">VQ-3 / VQ-5 / 株価 + 買いポイント</div>
    <div class="legend">
      <div class="leg"><div class="leg-line" style="background:var(--yellow)"></div>VQ-3</div>
      <div class="leg"><div class="leg-line" style="background:var(--orange)"></div>VQ-5</div>
      <div class="leg"><div class="leg-line" style="background:var(--blue)"></div>株価</div>
      <div class="leg"><div class="leg-line" style="background:rgba(0,170,255,.4);border-top:1px dashed rgba(0,170,255,.6)"></div>BP</div>
      <div class="leg"><div class="leg-dot" style="background:var(--red)"></div>シグナル</div>
    </div>
  </div>
  <canvas id="mc"></canvas>
  <div class="sbar">
    <div class="sdot-s" id="sdot"></div>
    <span id="stxt">初期化中...</span>
  </div>
</div>

<!-- VOLUME CHART -->
<div class="chart-wrap">
  <div class="chart-hdr">
    <div class="chart-title">出来高 ／ 20本平均 （RVol = 現在÷平均）</div>
    <div class="legend">
      <div class="leg"><div class="leg-line" style="background:rgba(0,255,136,.5)"></div>上げ出来高</div>
      <div class="leg"><div class="leg-line" style="background:rgba(255,58,58,.5)"></div>下げ出来高</div>
      <div class="leg"><div class="leg-line" style="background:#FF8C00"></div>20本MA</div>
    </div>
  </div>
  <canvas id="vc"></canvas>
</div>

<!-- DRY CHART -->
<div class="chart-wrap">
  <div class="chart-hdr">
    <div class="chart-title">売り枯れ率（0.5以下 → 売り枯れ · ベース右側のVDUを確認）</div>
    <div class="legend">
      <div class="leg"><div class="leg-line" style="background:var(--purple)"></div>売り枯れ率</div>
      <div class="leg"><div class="leg-dot" style="background:var(--red)"></div>売り枯れ確認</div>
    </div>
  </div>
  <canvas id="dc"></canvas>
</div>

<!-- SIGNAL LOG -->
<div class="log-wrap">
  <div class="log-hdr">
    <div class="log-hdr-title">📋 シグナル履歴</div>
    <button class="log-clear" onclick="clearLog()">クリア</button>
  </div>
  <div class="log-body" id="logBody">
    <div class="log-empty">銘柄を選択してください...</div>
  </div>
</div>

<script>
// ── STATE ──
let sym='TRGP', bp=253.87, trussSig='go';
let interval='1d';
let candles=[], vq3S=[], vq5S=[], dryS=[], priceS=[], volS=[], volMA=[];
let sigLog=[], lastSigState='', notifEnabled=false;
const TH={vq3:2.5, dry:0.5, vq5:3.0};

// ── STOOQ NOTES ──
// Stooq format: https://stooq.com/q/d/l/?s=TICKER.US&i=INTERVAL
// i=d (daily), i=w (weekly), i=m (monthly)
// For intraday: not available on free Stooq
// Returns CSV: Date,Open,High,Low,Close,Volume

// ── DATA FETCH — STOOQ (primary) ──
async function fetchStooq(ticker, iv){
  // Stooq interval mapping (intraday not available)
  const stooqIv = (iv==='1w') ? 'w' : 'd';
  const url = `https://stooq.com/q/d/l/?s=${ticker.toLowerCase()}.us&i=${stooqIv}`;
  const r = await fetch(url);
  if(!r.ok) throw new Error(`Stooq HTTP ${r.status}`);
  const text = await r.text();
  if(text.includes('No data') || text.trim().length < 30) throw new Error('Stooq: データなし');
  return parseCSV(text);
}

// ── DATA FETCH — STOOQ via allorigins proxy (fallback 1) ──
async function fetchStooqProxy(ticker, iv){
  const stooqIv = (iv==='1w') ? 'w' : 'd';
  const target = `https://stooq.com/q/d/l/?s=${ticker.toLowerCase()}.us&i=${stooqIv}`;
  const url = `https://api.allorigins.win/get?url=${encodeURIComponent(target)}`;
  const r = await fetch(url, {signal: AbortSignal.timeout(8000)});
  if(!r.ok) throw new Error(`Proxy HTTP ${r.status}`);
  const wrapper = await r.json();
  if(!wrapper.contents) throw new Error('Proxy: 空レスポンス');
  return parseCSV(wrapper.contents);
}

// ── DATA FETCH — Yahoo Finance via corsproxy.io (fallback 2) ──
async function fetchYahooCorsproxy(ticker, iv){
  const rangeMap={'5m':'2d','15m':'5d','1h':'30d','1d':'2y','1w':'5y'};
  const ivYahoo={'5m':'5m','15m':'15m','1h':'60m','1d':'1d','1w':'1wk'};
  const range = rangeMap[iv]||'2y';
  const interval = ivYahoo[iv]||'1d';
  const target = `https://query1.finance.yahoo.com/v8/finance/chart/${ticker}?interval=${interval}&range=${range}`;
  const url = `https://corsproxy.io/?${encodeURIComponent(target)}`;
  const r = await fetch(url, {signal: AbortSignal.timeout(10000)});
  if(!r.ok) throw new Error(`Yahoo proxy HTTP ${r.status}`);
  const data = await r.json();
  const result = data?.chart?.result?.[0];
  if(!result) throw new Error('Yahoo: データ構造エラー');
  const ts = result.timestamp;
  const q = result.indicators.quote[0];
  const out=[];
  for(let i=0;i<ts.length;i++){
    if(q.close[i]==null) continue;
    out.push({ts:ts[i]*1000, open:q.open[i]||q.close[i], high:q.high[i]||q.close[i], low:q.low[i]||q.close[i], close:q.close[i], volume:q.volume[i]||0});
  }
  return out;
}

// ── PARSE CSV (Stooq format) ──
function parseCSV(text){
  const lines = text.trim().split('\n');
  const out=[];
  for(let i=1;i<lines.length;i++){
    const cols = lines[i].split(',');
    if(cols.length<6) continue;
    const [dateStr,,,,close,vol] = cols;
    const [open,high,low] = [cols[1],cols[2],cols[3]];
    if(!dateStr||!close||close==='-') continue;
    const ts = new Date(dateStr).getTime();
    if(isNaN(ts)) continue;
    out.push({ts, open:parseFloat(open), high:parseFloat(high), low:parseFloat(low), close:parseFloat(close), volume:parseFloat(vol)||0});
  }
  // Stooq returns newest first sometimes — sort ascending
  out.sort((a,b)=>a.ts-b.ts);
  // Limit to last 200 candles
  return out.slice(-200);
}

// ── MASTER FETCH with fallback chain ──
let lastSource='';
async function fetchData(ticker, iv){
  const sources=[
    {name:'Stooq Direct', fn:()=>fetchStooq(ticker, iv)},
    {name:'Stooq (proxy)', fn:()=>fetchStooqProxy(ticker, iv)},
    {name:'Yahoo Finance (proxy)', fn:()=>fetchYahooCorsproxy(ticker, iv)},
  ];

  // For intraday, skip Stooq (daily only) and go to Yahoo
  const isIntraday = ['5m','15m','1h'].includes(iv);
  const filtered = isIntraday ? sources.filter(s=>s.name.includes('Yahoo')) : sources;

  let lastErr='';
  for(const src of filtered){
    try{
      document.getElementById('ovTxt').textContent=`${src.name} — ${ticker} 取得中...`;
      const data = await src.fn();
      if(data.length<5) throw new Error('データ行数不足');
      lastSource = src.name;
      updateDataBadge(src.name);
      hideErr();
      return data;
    }catch(e){
      lastErr=`${src.name}: ${e.message}`;
      console.warn(lastErr);
    }
  }
  throw new Error(lastErr || 'すべてのデータソースで失敗');
}

function updateDataBadge(src){
  const b=document.getElementById('dataBadge');
  if(src.includes('Stooq')) {b.textContent='●STOOQ';b.style.color='var(--yellow)';b.style.borderColor='rgba(255,208,0,.3)';}
  else if(src.includes('Yahoo')) {b.textContent='●YAHOO';b.style.color='var(--blue)';b.style.borderColor='rgba(0,170,255,.3)';}
}
function showErr(msg, src){
  const box=document.getElementById('errBox');
  box.classList.add('show');
  document.getElementById('errText').textContent=msg;
  document.getElementById('errSrc').textContent='最終試行: '+src;
}
function hideErr(){document.getElementById('errBox').classList.remove('show');}

// ── VQ CALC ──
function calcVQ(cs,endIdx,winSize){
  const start=Math.max(0,endIdx-winSize+1);
  const arr=cs.slice(start,endIdx+1);
  const bv=[],dv=[];
  arr.forEach(c=>{
    if(!c.volume||c.volume<=0)return;
    if(c.close>c.open)bv.push(c.volume);
    else if(c.close<c.open)dv.push(c.volume);
  });
  const avg=a=>a.length?a.reduce((s,v)=>s+v,0)/a.length:0;
  const ab=avg(bv),ad=avg(dv);
  if(ad===0)return ab>0?5.0:1.0;
  return ab/ad;
}

// ── BUILD SERIES ──
function buildSeries(cs){
  const n=cs.length;
  vq3S=Array.from({length:n},(_,i)=>calcVQ(cs,i,3));
  vq5S=Array.from({length:n},(_,i)=>calcVQ(cs,i,5));
  priceS=cs.map(c=>c.close);
  volS=cs.map(c=>c.volume);
  volMA=cs.map((_,i)=>{const w=cs.slice(Math.max(0,i-19),i+1);return w.reduce((s,c)=>s+c.volume,0)/w.length;});
  dryS=cs.map((_,i)=>{
    const sw=cs.slice(Math.max(0,i-4),i+1);
    const lw=cs.slice(Math.max(0,i-19),i+1);
    const bv=a=>a.filter(c=>c.close<c.open).map(c=>c.volume);
    const avg=a=>a.length?a.reduce((x,y)=>x+y,0)/a.length:0;
    return avg(bv(sw))/(avg(bv(lw))||1);
  });
}

// ── EVAL SIGNAL ──
function evalSignal(){
  const n=candles.length;
  const v3=vq3S[n-1]||0, v5=vq5S[n-1]||0, dry=dryS[n-1]||1;
  const price=priceS[n-1], first=priceS[0];
  const chg=(price-first)/first*100;
  const c1=v3>=TH.vq3, c2=dry<=TH.dry, c3=v5>=TH.vq5;

  updateCond('cond1','c1val','c1status',v3.toFixed(2),
    c1?`✅ ${v3.toFixed(2)} ≥ ${TH.vq3}`:`❌ ${v3.toFixed(2)} < ${TH.vq3}`,c1,'var(--yellow)');
  updateCond('cond2','c2val','c2status',dry.toFixed(2),
    c2?`✅ ${dry.toFixed(2)} < ${TH.dry}`:`❌ ${dry.toFixed(2)} ≥ ${TH.dry}`,c2,'var(--purple)');
  updateCond('cond3','c3val','c3status',v5.toFixed(2),
    c3?`✅ ${v5.toFixed(2)} ≥ ${TH.vq5}`:`❌ ${v5.toFixed(2)} < ${TH.vq5}`,c3,'var(--orange)');

  const fmtP=p=>'$'+p.toFixed(2);
  document.getElementById('sigSym').textContent=sym;
  document.getElementById('sigPrice').textContent='$'+price.toFixed(2);
  document.getElementById('sigChange').textContent=(chg>=0?'+':'')+chg.toFixed(2)+'%';
  document.getElementById('sigChange').style.color=chg>=0?'var(--green)':'var(--red)';
  document.getElementById('sigBP').textContent=bp>0?`BP: $${bp.toFixed(2)} → Dist: ${((price-bp)/bp*100>=0?'+':'')+((price-bp)/bp*100).toFixed(1)}%`:'BP: —';

  // TRUSS Panel update
  updateTrussPanel(price, v3, v5, dry, c1, c2, c3);

  // Signal box
  const box=document.getElementById('sigBox');
  const icon=document.getElementById('sigIcon');
  const title=document.getElementById('sigTitle');
  const sub=document.getElementById('sigSub');
  let state='none';

  if(c3&&c2){
    box.className='sig-box full';icon.textContent='🟢';
    title.textContent='本シグナル — エントリー確認';title.style.color='var(--green)';
    sub.textContent='VQ-5突破 + 売り枯れ確認 — BPとの距離を確認してエントリー';
    state='full';
  }else if(c1&&c2&&!c3){
    box.className='sig-box prep';icon.textContent='🟠';
    title.textContent='VQ-3先行シグナル';title.style.color='var(--yellow)';
    sub.textContent='VQ-3突破 + 売り枯れ — VQ-5突破を待つ';
    state='prep';
  }else if(c1&&!c2){
    box.className='sig-box warn';icon.textContent='🟡';
    title.textContent='VQ-3上昇中';title.style.color='var(--yellow)';
    sub.textContent='買い圧力増加 — 売り枯れ率の低下を確認';
    state='warn';
  }else if(c2){
    box.className='sig-box dry';icon.textContent='🟣';
    title.textContent='売り枯れ検出';title.style.color='var(--purple)';
    sub.textContent='売り手が消えつつある — VQ上昇（買い圧力）を待つ';
    state='dry';
  }else{
    if(trussSig==='caution'){box.className='sig-box caution';icon.textContent='⚠️';}
    else box.className='sig-box';
    icon.textContent=trussSig==='caution'?'⚠️':'⏸';
    title.textContent=trussSig==='caution'?'投機銘柄 — 様子見':'様子見';
    title.style.color=trussSig==='caution'?'var(--red)':'var(--dim)';
    sub.textContent='条件未達成';state='none';
  }

  if(state!==lastSigState&&state!=='none'){
    addLog(state,v3,v5,dry,price,new Date(candles[n-1].ts));
    const p='$'+price.toFixed(2);
    if(state==='full') sendNotif(`🟢 本シグナル — ${sym}`,`VQ-5:${v5.toFixed(2)} 売り枯れ:${dry.toFixed(2)} 価格:${p}`,'high');
    else if(state==='prep') sendNotif(`🟠 VQ-3先行 — ${sym}`,`VQ-3:${v3.toFixed(2)} 売り枯れ:${dry.toFixed(2)} 価格:${p}`,'medium');
    lastSigState=state;
  }
}

function updateTrussPanel(price, v3, v5, dry, c1, c2, c3){
  document.getElementById('trussSym').textContent=sym;
  document.getElementById('tgBP').textContent=bp>0?'$'+bp.toFixed(2):'—';
  document.getElementById('tgBPnote').textContent=`${sym} IBD 買いポイント`;

  // Distance
  if(bp>0){
    const dist=(price-bp)/bp*100;
    const distTxt=(dist>=0?'+':'')+dist.toFixed(1)+'%';
    document.getElementById('tgDist').textContent=distTxt;
    const distAbs=Math.abs(dist);
    const col=distAbs<=5?'var(--green)':distAbs<=10?'var(--yellow)':'var(--red)';
    document.getElementById('tgDist').style.color=col;
    document.getElementById('tgDistBar').style.width=Math.min(distAbs/15*100,100)+'%';
    document.getElementById('tgDistBar').style.background=col;
    document.getElementById('tgDistNote').textContent=distAbs<=5?'✅ 買いゾーン内':distAbs<=10?'⚠ やや延長':'❌ 延長 — 待機';
  }

  // RVol
  const n=candles.length;
  const curVol=volS[n-1]||0, avgVol=volMA[n-1]||1;
  const rvol=curVol/avgVol;
  document.getElementById('tgRvol').textContent=rvol.toFixed(2)+'x';
  document.getElementById('tgRvol').style.color=rvol>=2?'var(--green)':rvol>=1.5?'var(--yellow)':'var(--dim)';
  document.getElementById('tgRvolBar').style.width=Math.min(rvol/3*100,100)+'%';
  document.getElementById('tgRvolBar').style.background=rvol>=2?'var(--green)':rvol>=1.5?'var(--yellow)':'var(--dim)';
  document.getElementById('tgRvolNote').textContent=rvol>=2?'⚡ 大量出来高 — ブレイクアウト確認':rvol>=1.5?'↑ 平均超え':rvol>=1?'→ 平均水準':'↓ 出来高縮小 (VDU候補)';

  // VDU — last 5 bars vol < 70% of 20MA
  const recent=volS.slice(-5);
  const vduCount=recent.filter(v=>v<avgVol*0.7).length;
  const isVDU=vduCount>=3;
  document.getElementById('tgVDU').textContent=isVDU?`VDU検出 (${vduCount}/5)`:`なし (${vduCount}/5)`;
  document.getElementById('tgVDU').style.color=isVDU?'var(--purple)':'var(--dim)';
  document.getElementById('tgVDUnote').textContent=isVDU?'✅ ベース形成中 — 次の出来高爆発を待つ':'→ 出来高縮小を確認中';

  // Composite TRUSS+VQ badge
  let badge='WAIT', badgeClass='tsb-wait';
  if(trussSig==='caution'){badge='CAUTION';badgeClass='tsb-caution';}
  else if(c3&&c2){badge='GO';badgeClass='tsb-go';}
  else if(c1&&c2){badge='WATCH';badgeClass='tsb-watch';}
  document.getElementById('trussBadge').textContent=badge;
  document.getElementById('trussBadge').className='truss-signal-badge '+badgeClass;
}

function updateCond(id,valId,statusId,val,statusTxt,ok,col){
  const el=document.getElementById(id);
  el.style.color=ok?col:'var(--dim)';
  ok?el.classList.add('ok'):el.classList.remove('ok');
  document.getElementById(valId).textContent=val;
  document.getElementById(valId).style.color=ok?col:'var(--dim)';
  document.getElementById(statusId).textContent=statusTxt;
  document.getElementById(statusId).style.color=ok?col:'var(--dim)';
}

// ── LOG ──
function addLog(state,v3,v5,dry,price,ct){
  const labels={full:{icon:'🟢',msg:'本シグナル',col:'var(--green)'},prep:{icon:'🟡',msg:'VQ-3先行',col:'var(--yellow)'},warn:{icon:'🟡',msg:'VQ-3上昇',col:'var(--yellow)'},dry:{icon:'🟣',msg:'売り枯れ',col:'var(--purple)'}};
  const l=labels[state]||{icon:'⏸',msg:state,col:'var(--dim)'};
  sigLog.unshift({time:new Date().toLocaleTimeString('ja-JP'),ct:ct.toLocaleDateString('ja-JP'),state,v3,v5,dry,price,sym,...l});
  if(sigLog.length>20)sigLog.pop();
  renderLog();
}
function renderLog(){
  const body=document.getElementById('logBody');
  if(!sigLog.length){body.innerHTML='<div class="log-empty">シグナル待ち...</div>';return;}
  body.innerHTML=sigLog.map(l=>`
    <div class="log-row">
      <div><div class="log-time">${l.time}</div><div class="log-time" style="color:rgba(90,122,154,.5);font-size:7px">${l.sym} ${l.ct}</div></div>
      <div class="log-msg" style="color:${l.col}">${l.icon} ${l.msg}</div>
      <div class="log-detail"><div>V3:${(l.v3||0).toFixed(1)} V5:${(l.v5||0).toFixed(1)}</div><div>Dry:${(l.dry||0).toFixed(2)} $${(l.price||0).toFixed(2)}</div></div>
    </div>`).join('');
}
function clearLog(){sigLog=[];lastSigState='';renderLog();}

// ── DRAW MAIN ──
function drawMain(){
  const cv=document.getElementById('mc');
  const dpr=window.devicePixelRatio||1;
  const W=cv.parentElement.offsetWidth;
  const H=Math.min(300,window.innerHeight*0.36);
  cv.width=W*dpr;cv.height=H*dpr;cv.style.width=W+'px';cv.style.height=H+'px';
  const ctx=cv.getContext('2d');ctx.scale(dpr,dpr);
  const PAD={top:10,right:60,bottom:22,left:36};
  const cw=W-PAD.left-PAD.right,ch=H-PAD.top-PAD.bottom;
  const n=candles.length;if(n<2)return;

  const allVQ=[...vq3S,...vq5S].filter(v=>isFinite(v)&&v>0);
  const vqMax=allVQ.length?Math.min(Math.max(...allVQ,4),15):15;
  const xStep=cw/(n-1);
  const xOf=i=>PAD.left+i*xStep;
  const yVQ=v=>PAD.top+ch*(1-v/vqMax);
  const pArr=priceS.filter(v=>v>0);
  const pMin=Math.min(...pArr)*.999, pMax=Math.max(...pArr)*1.001, pRange=pMax-pMin||1;
  const yPr=p=>PAD.top+ch*(1-(p-pMin)/pRange);
  ctx.clearRect(0,0,W,H);

  // BP dashed line
  if(bp>0&&bp>=pMin&&bp<=pMax*1.05){
    const yBP=yPr(bp);
    ctx.setLineDash([4,6]);
    ctx.strokeStyle='rgba(0,170,255,.5)';ctx.lineWidth=1.2;
    ctx.beginPath();ctx.moveTo(PAD.left,yBP);ctx.lineTo(PAD.left+cw,yBP);ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='rgba(0,170,255,.75)';ctx.font=`bold 8px 'Share Tech Mono'`;
    ctx.textAlign='left';ctx.fillText(`BP $${bp.toFixed(2)}`,PAD.left+cw+3,yBP+3);
  }

  // VQ threshold grid
  ctx.setLineDash([2,4]);
  [[TH.vq3,'rgba(255,230,0,.25)','rgba(255,230,0,.6)'],[TH.vq5,'rgba(255,69,0,.25)','rgba(255,69,0,.6)']].forEach(([t,sc,fc])=>{
    const y=yVQ(t);
    ctx.strokeStyle=sc;ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(PAD.left,y);ctx.lineTo(PAD.left+cw,y);ctx.stroke();
    ctx.fillStyle=fc;ctx.font=`8px 'Share Tech Mono'`;ctx.textAlign='right';
    ctx.fillText(t.toFixed(1),PAD.left-3,y+3);
  });
  ctx.setLineDash([]);

  // Price area fill
  ctx.beginPath();
  priceS.forEach((p,i)=>{if(!p)return;i===0?ctx.moveTo(xOf(i),yPr(p)):ctx.lineTo(xOf(i),yPr(p));});
  ctx.lineTo(xOf(n-1),PAD.top+ch);ctx.lineTo(xOf(0),PAD.top+ch);ctx.closePath();
  const pg=ctx.createLinearGradient(0,PAD.top,0,PAD.top+ch);
  pg.addColorStop(0,'rgba(0,170,255,.1)');pg.addColorStop(1,'rgba(0,170,255,0)');
  ctx.fillStyle=pg;ctx.fill();

  // VQ-5
  ctx.beginPath();let s5=false;
  vq5S.forEach((v,i)=>{if(!isFinite(v))return;const x=xOf(i),y=yVQ(Math.min(v,vqMax));s5?ctx.lineTo(x,y):ctx.moveTo(x,y);s5=true;});
  ctx.strokeStyle='rgba(255,69,0,.75)';ctx.lineWidth=1.4;ctx.stroke();

  // VQ-3
  ctx.beginPath();let s3=false;
  vq3S.forEach((v,i)=>{if(!isFinite(v))return;const x=xOf(i),y=yVQ(Math.min(v,vqMax));s3?ctx.lineTo(x,y):ctx.moveTo(x,y);s3=true;});
  ctx.strokeStyle='rgba(255,230,0,.8)';ctx.lineWidth=1.4;ctx.stroke();

  // Entry zones (VQ5 + dry)
  for(let i=1;i<n;i++){
    if((vq5S[i]||0)>=TH.vq5&&dryS[i]<=TH.dry){
      ctx.fillStyle='rgba(0,255,136,.07)';
      ctx.fillRect(xOf(i-1),PAD.top,xStep,ch);
    }
  }

  // VQ-3 先行マーカー
  vq3S.forEach((v,i)=>{
    if(!isFinite(v)||i===0)return;
    if(v>=TH.vq3&&(vq3S[i-1]||0)<TH.vq3&&dryS[i]<=TH.dry){
      const x=xOf(i),y=yPr(priceS[i]);
      ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fillStyle='rgba(255,208,0,.85)';ctx.fill();
      ctx.fillStyle='rgba(255,208,0,.9)';ctx.font=`bold 8px 'Share Tech Mono'`;ctx.textAlign='center';
      const d=new Date(candles[i].ts);
      ctx.fillText((d.getMonth()+1)+'/'+d.getDate(),x,y-10);
    }
  });

  // VQ-5 本シグナルマーカー
  vq5S.forEach((v,i)=>{
    if(!isFinite(v)||i===0)return;
    if(v>=TH.vq5&&(vq5S[i-1]||0)<TH.vq5&&dryS[i]<=TH.dry){
      const x=xOf(i),y=yPr(priceS[i]);
      ctx.beginPath();ctx.arc(x,y,6,0,Math.PI*2);ctx.fillStyle='rgba(255,58,58,.9)';ctx.fill();
      ctx.fillStyle='rgba(255,100,100,.95)';ctx.font=`bold 8px 'Share Tech Mono'`;ctx.textAlign='center';
      const d=new Date(candles[i].ts);
      ctx.fillText((d.getMonth()+1)+'/'+d.getDate(),x,y+18);
    }
  });

  // Price line
  ctx.beginPath();
  let sp=false;
  priceS.forEach((p,i)=>{if(!p)return;sp?ctx.lineTo(xOf(i),yPr(p)):ctx.moveTo(xOf(i),yPr(p));sp=true;});
  ctx.strokeStyle='rgba(0,170,255,.85)';ctx.lineWidth=2;ctx.stroke();
  const lastP=priceS[n-1];
  ctx.beginPath();ctx.arc(xOf(n-1),yPr(lastP),4,0,Math.PI*2);ctx.fillStyle='#00AAFF';ctx.fill();

  // Right Y axis (price)
  ctx.textAlign='left';ctx.font=`8px 'Share Tech Mono'`;
  for(let i=0;i<=3;i++){
    const p=pMin+pRange*i/3,y=yPr(p);
    if(y<PAD.top||y>PAD.top+ch)continue;
    ctx.fillStyle='rgba(0,170,255,.35)';
    ctx.fillText('$'+p.toFixed(0),PAD.left+cw+4,y+3);
  }

  // X axis
  ctx.textAlign='center';ctx.fillStyle='rgba(90,122,154,.5)';ctx.font=`8px 'Share Tech Mono'`;
  for(let i=0;i<=5;i++){
    const idx=Math.round(i*(n-1)/5);
    const d=new Date(candles[idx].ts);
    const lbl=`${d.getFullYear()%100}/${(d.getMonth()+1).toString().padStart(2,'0')}/${d.getDate().toString().padStart(2,'0')}`;
    ctx.fillText(lbl,xOf(idx),PAD.top+ch+14);
  }
}

// ── DRAW VOLUME ──
function drawVolume(){
  const cv=document.getElementById('vc');
  const dpr=window.devicePixelRatio||1;
  const W=cv.parentElement.offsetWidth,H=100;
  cv.width=W*dpr;cv.height=H*dpr;cv.style.width=W+'px';cv.style.height=H+'px';
  const ctx=cv.getContext('2d');ctx.scale(dpr,dpr);
  const PAD={top:6,right:60,bottom:18,left:36};
  const cw=W-PAD.left-PAD.right,ch=H-PAD.top-PAD.bottom;
  const n=candles.length;if(n<2)return;
  const vMax=Math.max(...volS)*1.05||1;
  const xStep=cw/(n-1);
  const xOf=i=>PAD.left+i*xStep;
  const yV=v=>PAD.top+ch*(1-v/vMax);
  ctx.clearRect(0,0,W,H);
  const barW=Math.max(1,xStep*0.75);
  volS.forEach((v,i)=>{
    const c=candles[i],aboveMA=volMA[i]&&v>volMA[i],bull=c.close>=c.open;
    ctx.fillStyle=aboveMA?(bull?'rgba(0,255,136,.75)':'rgba(255,58,58,.75)'):(bull?'rgba(0,255,136,.28)':'rgba(255,58,58,.28)');
    ctx.fillRect(xOf(i)-barW/2,yV(v),barW,Math.max(1,ch-(yV(v)-PAD.top)));
  });
  ctx.beginPath();let sma=false;
  volMA.forEach((v,i)=>{if(!v)return;const x=xOf(i),y=yV(v);sma?ctx.lineTo(x,y):ctx.moveTo(x,y);sma=true;});
  ctx.strokeStyle='rgba(255,140,0,.85)';ctx.lineWidth=1.5;ctx.stroke();
  const fv=v=>v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(0)+'K':v.toFixed(0);
  ctx.textAlign='left';ctx.font=`8px 'Share Tech Mono'`;ctx.fillStyle='rgba(90,122,154,.4)';
  ctx.fillText(fv(vMax),PAD.left+cw+4,PAD.top+8);
  ctx.textAlign='center';
  for(let i=0;i<=4;i++){
    const idx=Math.round(i*(n-1)/4);
    const d=new Date(candles[idx].ts);
    ctx.fillText(`${(d.getMonth()+1)}/${d.getDate()}`,xOf(idx),PAD.top+ch+12);
  }
}

// ── DRAW DRY ──
function drawDry(){
  const cv=document.getElementById('dc');
  const dpr=window.devicePixelRatio||1;
  const W=cv.parentElement.offsetWidth,H=100;
  cv.width=W*dpr;cv.height=H*dpr;cv.style.width=W+'px';cv.style.height=H+'px';
  const ctx=cv.getContext('2d');ctx.scale(dpr,dpr);
  const PAD={top:8,right:80,bottom:18,left:36};
  const cw=W-PAD.left-PAD.right,ch=H-PAD.top-PAD.bottom;
  const n=candles.length;if(n<2)return;
  const validDry=dryS.filter(v=>isFinite(v)&&v>=0);
  const dMax=validDry.length?Math.min(Math.max(...validDry,2),4):2;
  const xStep=cw/(n-1);
  const xOf=i=>PAD.left+i*xStep;
  const yD=d=>PAD.top+ch*(1-Math.min(d,dMax)/dMax);
  const yHalf=yD(TH.dry);
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='rgba(255,58,58,.1)';ctx.fillRect(PAD.left,yHalf,cw,PAD.top+ch-yHalf);
  ctx.strokeStyle='rgba(255,80,80,.8)';ctx.lineWidth=2;ctx.setLineDash([]);
  ctx.beginPath();ctx.moveTo(PAD.left,yHalf);ctx.lineTo(PAD.left+cw,yHalf);ctx.stroke();
  ctx.fillStyle='rgba(255,100,100,.95)';ctx.font=`bold 9px 'Share Tech Mono'`;ctx.textAlign='left';
  ctx.fillText('← 売り枯れ',PAD.left+cw+4,yHalf+4);
  ctx.fillStyle='rgba(255,100,100,.7)';ctx.font=`8px 'Share Tech Mono'`;ctx.textAlign='right';
  ctx.fillText('0.5',PAD.left-3,yHalf+4);
  ctx.fillStyle='rgba(90,122,154,.4)';ctx.textAlign='right';
  ctx.fillText(dMax.toFixed(0),PAD.left-3,PAD.top+8);
  ctx.beginPath();
  dryS.forEach((d,i)=>{const cd=Math.min(d||0,dMax);i===0?ctx.moveTo(xOf(i),yD(cd)):ctx.lineTo(xOf(i),yD(cd));});
  ctx.lineTo(xOf(n-1),PAD.top+ch);ctx.lineTo(xOf(0),PAD.top+ch);ctx.closePath();
  const g=ctx.createLinearGradient(0,PAD.top,0,PAD.top+ch);
  g.addColorStop(0,'rgba(168,85,247,.22)');g.addColorStop(1,'rgba(168,85,247,0)');
  ctx.fillStyle=g;ctx.fill();
  for(let i=1;i<n;i++){
    const d=Math.min(dryS[i]||0,dMax),dp=Math.min(dryS[i-1]||0,dMax);
    ctx.beginPath();ctx.moveTo(xOf(i-1),yD(dp));ctx.lineTo(xOf(i),yD(d));
    ctx.strokeStyle=d<TH.dry?'rgba(255,80,80,.9)':'rgba(168,85,247,.45)';
    ctx.lineWidth=d<TH.dry?2.2:1.2;ctx.stroke();
  }
  dryS.forEach((d,i)=>{
    if(d<TH.dry&&i>0&&(dryS[i-1]||0)>=TH.dry){
      const x=xOf(i),y=yD(Math.min(d,dMax));
      ctx.beginPath();ctx.arc(x,y,7,0,Math.PI*2);ctx.fillStyle='#FF3A3A';ctx.fill();
      ctx.strokeStyle='rgba(255,150,150,.5)';ctx.lineWidth=2;ctx.stroke();
      const t=new Date(candles[i].ts);
      ctx.fillStyle='rgba(255,130,130,.95)';ctx.font=`bold 9px 'Share Tech Mono'`;
      ctx.textAlign='center';ctx.fillText(`${t.getMonth()+1}/${t.getDate()}`,x,y-12);
    }
  });
  ctx.textAlign='center';ctx.fillStyle='rgba(90,122,154,.4)';ctx.font=`8px 'Share Tech Mono'`;
  for(let i=0;i<=4;i++){
    const idx=Math.round(i*(n-1)/4);
    const d=new Date(candles[idx].ts);
    ctx.fillText(`${d.getMonth()+1}/${d.getDate()}`,xOf(idx),PAD.top+ch+12);
  }
}

// ── STATUS ──
function setStatus(s,m=''){
  const d=document.getElementById('sdot'),t=document.getElementById('stxt');
  if(s==='live'){d.className='sdot-s live';t.textContent=`LIVE — ${sym} [${lastSource||'Stooq'}] ${interval} ${new Date().toLocaleTimeString('ja-JP')}`;}
  else if(s==='ld'){d.className='sdot-s';t.textContent='取得中...';}
  else{d.className='sdot-s err';t.textContent='エラー: '+m;}
}

// ── SELECT STOCK ──
function selectStock(el){
  document.querySelectorAll('.stock-btn').forEach(b=>{
    b.className='stock-btn';
  });
  const dotClass=`sdot-${el.dataset.dot}`;
  el.className=`stock-btn on-${el.dataset.truss}`;

  sym=el.dataset.sym;
  bp=parseFloat(el.dataset.bp)||0;
  trussSig=el.dataset.truss;

  // AXTI caution banner
  document.getElementById('cautionBanner').style.display=sym==='AXTI'?'block':'none';

  sigLog=[];lastSigState='';renderLog();
  updateData();
}

function setIv(el){
  interval=el.dataset.iv;
  document.querySelectorAll('.ivbtn').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');
  sigLog=[];lastSigState='';
  updateData();
}

function doRefresh(){
  const b=document.getElementById('rfBtn');
  b.classList.add('spin');setTimeout(()=>b.classList.remove('spin'),500);
  updateData();
}

// ── MAIN UPDATE ──
async function updateData(){
  setStatus('ld');
  document.getElementById('ov').classList.remove('hide');
  try{
    candles=await fetchData(sym, interval);
    buildSeries(candles);
    evalSignal();
    drawMain();drawVolume();drawDry();
    setStatus('live');
  }catch(e){
    setStatus('error',e.message);
    showErr(e.message, lastSource||'—');
  }
  document.getElementById('ov').classList.add('hide');
}

// ── NOTIF ──
async function requestNotif(){
  if(!('Notification' in window)){alert('通知非対応');return;}
  const perm=await Notification.requestPermission();
  notifEnabled=perm==='granted';
  updateNotifBtn();
  if(notifEnabled)new Notification('VQ STOCKS 通知ON',{body:'株式シグナルをお知らせします'});
}
function updateNotifBtn(){
  const btn=document.getElementById('notifBtn');if(!btn)return;
  if(Notification.permission==='granted'){btn.textContent='🔔 ON';btn.style.borderColor='var(--yellow)';btn.style.color='var(--yellow)';notifEnabled=true;}
  else if(Notification.permission==='denied'){btn.textContent='🔕';btn.style.borderColor='var(--red)';btn.style.color='var(--red)';}
}
function sendNotif(title,body,urgency='normal'){
  if(!notifEnabled||Notification.permission!=='granted')return;
  try{new Notification(title,{body,tag:'vq-stocks',requireInteraction:urgency==='high'});}catch(e){}
}

window.addEventListener('resize',()=>{if(candles.length){drawMain();drawVolume();drawDry();}});
updateNotifBtn();

// Auto-select first stock on load
document.querySelector('.stock-btn').click();

// Auto-refresh every 5 minutes (株式は頻度落とす)
setInterval(updateData, 5*60*1000);
</script>
